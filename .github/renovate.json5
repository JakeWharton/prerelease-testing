{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'github>JakeWharton/renovate-config:default.json5',
	],
	rebaseWhen: 'behind-base-branch',
	ignoreUnstable: false,
	respectLatest: false,
	separateMinorPatch: true,
	separateMultipleMajor: true,
	separateMultipleMinor: true,
	prConcurrentLimit: 0,
	prHourlyLimit: 0,
	packageRules: [
		// Override parent config's default age.
		{
			matchPackageNames: ['*'],
			minimumReleaseAge: '0 days',
		},
		// We do not want prerelease actions.
		{
			matchDepTypes: ['actions'],
			ignoreUnstable: true,
		},
	],
}
